# Line endings: the tests match on a bare newline (tests/theme.test.js), so every text
# file is LF in the working tree on every machine, whatever core.autocrlf says. Found
# 2026-10-07: a fresh worktree on a machine with autocrlf=true checked out CRLF and the
# theme test failed at import.
* text=auto eol=lf
*.png binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ico binary
